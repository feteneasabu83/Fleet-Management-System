// Fleet Management System - Prisma schema
// Keeps only fleet-related models plus core user/auth/department models.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================================================================
// CORE ENUMS
// ====================================================================

enum UserRole {
  ADMIN
  SUPPORT_AGENT
  Department_Head
  Commissioner
  END_USER
  Driver
  Fleet_Manager
  Maintenance_Team
  Maintenace_Team
  Team_Leader
  Finance_Department
  Announcement_Creator
  Women_Social_Inclusion
  Ethics_Anti_Corruption
}

enum UserType {
  INTERNAL
  EXTERNAL
}

enum Gender {
  MALE
  FEMALE
}

enum DisabilityType {
  BLIND
  DEAF
  PHYSICAL_OR_MOVEMENT_DISORDER
  MENTAL_RETARDATION
  OVERLAPPING_FACES
  PSYCHOLOGICAL_AND_SOCIAL_DISORDER
}

// Account status for enabling/disabling user accounts
enum AccountStatus {
  ENABLED
  DISABLED
}

enum ReadStatus {
  OPEN
  CLOSED
}

enum Language {
  EN
  AM
  OR
  TI
  SO
  SI
  WO
}

// Decision status for general requests (e.g., FieldRequest)
enum RequestDecisionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MaintenanceStatus {
  PENDING
  IN_PROGRESS
  MAINTAINED
}

enum FuelAmountType {
  LITER
  COUPON
  CASH
}

enum FuelStatus {
  FUELED
  NOT_FUELED
  HALF_FUELED
}

enum VehicleType {
  NEW
  USED
}

enum MaintainedVehicleStatus {
  ACCEPTED
  REJECTED
}

// ====================================================================
// FLEET MAINTENANCE REQUEST & APPROVAL WORKFLOW ENUMS
// ====================================================================

enum MaintenanceRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_MAINTENANCE_REVIEW
  MAINTENANCE_APPROVED
  MAINTENANCE_DISAPPROVED
  PENDING_FLEET_MANAGER
  FLEET_MANAGER_ACCEPTED
  FLEET_MANAGER_REJECTED
  IN_PROGRESS
  COMPLETED
  RETURNED_TO_DRIVER
  CANCELLED
}

enum MaintenanceCategory {
  MECHANICAL
  ELECTRICAL
  TIRE
  ENGINE
  ACCIDENT
  ROUTINE_SERVICE
  OTHER
}

enum VehicleCondition {
  OPERATIONAL
  PARTIALLY_OPERATIONAL
  NOT_OPERATIONAL
}

enum InspectionDecision {
  APPROVED
  DISAPPROVED
}

enum ManagerDecision {
  ACCEPTED
  REJECTED
}

enum RepairVehicleStatus {
  REPAIRED
  PARTIALLY_REPAIRED
  NOT_REPAIRED
}

enum WorkshopType {
  INTERNAL
  EXTERNAL
}

// ====================================================================
// USER MODEL
// ====================================================================

model User {
  id             String          @id @default(uuid()) @db.Uuid
  email          String          @unique
  firstName      String
  middleName     String?
  lastName       String
  firstNameAm    String?
  middleNameAm   String?
  lastNameAm     String?
  password       String
  phone          String?
  photoUrl       String?
  role           UserRole
  userType       UserType
  gender         Gender?
  isDisabled     Boolean         @default(false)
  disabilityType DisabilityType?
  departmentId   String?         @db.Uuid
  department     Department?     @relation(fields: [departmentId], references: [id])
  isActive       Boolean         @default(true)
  accountStatus  AccountStatus   @default(ENABLED)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  auditLogs           AuditLog[]
  fleetRequests       FleetRequest[]
  drivenTrips         Trip[]
  userPermissions     UserPermission[]
  vehicles            Vehicle[]
  vehicleNotifications VehicleNotification[]
  FieldRequest        FieldRequest[]
  FieldNotification   FieldNotification[]

  hrNotificationsRequested HrNotification[] @relation("HrNotificationRequester")
  hrNotificationsActioned  HrNotification[] @relation("HrNotificationActionBy")

  userNotificationsReceived UserNotification[] @relation("UserNotificationRecipient")
  userNotificationsActioned UserNotification[] @relation("UserNotificationActionBy")

  DriverDetaile DriverDetaile[]

  maintenanceSchedulesOwned    MaintenanceSchedule[] @relation("MaintenanceScheduleOwner")
  maintenanceSchedulesActioned MaintenanceSchedule[] @relation("MaintenanceScheduleActionBy")
  VehicleReturn                VehicleReturn[]
  ServiceRegistration          ServiceRegistration[]
  fuelRequests                 FuelRequest[]
  drivingRequests              FleetRequest[]        @relation("FleetRequestDriver")
  requestedFleetRequests       FleetRequest[]        @relation("FleetRequestRequestor")
  tripHistoryAsDriver          TripHistory[]         @relation("TripHistoryDriver")
  tripHistoryAsRequestor       TripHistory[]         @relation("TripHistoryRequestor")

  // Maintenance approval workflow relations
  maintenanceRequestsSubmitted MaintenanceRequest[]          @relation("MaintenanceRequestDriver")
  maintenanceInspectionsDone    MaintenanceInspection[]      @relation("MaintenanceInspectionOfficer")
  fleetManagerDecisionsMade     FleetManagerDecision[]       @relation("FleetManagerDecisionManager")
  maintenanceTasksAssigned      MaintenanceTask[]            @relation("MaintenanceTaskTechnician")
  maintenanceHistoryActions     MaintenanceApprovalHistory[] @relation("MaintenanceHistoryActor")
}

// ====================================================================
// DEPARTMENT
// ====================================================================

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  nameAm      String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users             User[]
  fleetRequests     FleetRequest[]
  FieldRequest      FieldRequest[]
  FieldNotification FieldNotification[]
  UserNotification  UserNotification[]
  TripHistory       TripHistory[]
}

// ====================================================================
// MODULE & PERMISSION MODELS
// ====================================================================

model Module {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  userPermissions UserPermission[]
}

model Permission {
  id              Int              @id @default(autoincrement())
  action          String           @unique
  userPermissions UserPermission[]
}

model UserPermission {
  id           Int      @id @default(autoincrement())
  userId       String   @db.Uuid
  moduleId     Int
  permissionId Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id])
  module     Module     @relation(fields: [moduleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([userId, moduleId, permissionId])
}

// ====================================================================
// SYSTEM SETTINGS & PASSWORD POLICY
// ====================================================================

model SystemSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PasswordPolicy {
  id                       Int      @id @default(autoincrement())
  minLength                Int      @default(12)
  requireUppercase         Boolean  @default(true)
  requireLowercase         Boolean  @default(true)
  requireDigit             Boolean  @default(true)
  requireSpecialcharSymbol Boolean  @default(true)
  expirationDays           Int      @default(90)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

// ====================================================================
// AUDIT LOG
// ====================================================================

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  action    String
  entity    String
  entityId  String
  userId    String   @db.Uuid
  oldValues Json?
  newValues Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ====================================================================
// FLEET NOTIFICATIONS
// ====================================================================

model VehicleNotification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  vehicleId String?  @db.Uuid
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([userId])
  @@index([vehicleId])
}

model FieldNotification {
  id             String   @id @default(uuid()) @db.Uuid
  message        String
  userId         String   @db.Uuid
  fieldRequestId String   @db.Uuid
  departmentId   String?  @db.Uuid
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  fieldRequest FieldRequest @relation(fields: [fieldRequestId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])

  @@index([userId])
  @@index([fieldRequestId])
  @@index([departmentId])
}

model HrNotification {
  id             String   @id @default(uuid()) @db.Uuid
  message        String
  fieldRequestId String   @db.Uuid
  reqId          String   @db.Uuid
  actionByUserId String?  @db.Uuid
  createdAt      DateTime @default(now())

  fieldRequest FieldRequest @relation(fields: [fieldRequestId], references: [id])
  requester    User         @relation("HrNotificationRequester", fields: [reqId], references: [id])
  actionBy     User?        @relation("HrNotificationActionBy", fields: [actionByUserId], references: [id])

  @@index([fieldRequestId])
  @@index([reqId])
  @@index([actionByUserId])
}

model UserNotification {
  id        String                 @id @default(uuid()) @db.Uuid
  userId    String                 @db.Uuid
  message   String
  status    RequestDecisionStatus?
  isRead    Boolean                @default(false)
  createdAt DateTime               @default(now())

  fieldRequestId String? @db.Uuid
  departmentId   String? @db.Uuid
  actionByUserId String? @db.Uuid

  user         User          @relation("UserNotificationRecipient", fields: [userId], references: [id])
  actionBy     User?         @relation("UserNotificationActionBy", fields: [actionByUserId], references: [id])
  fieldRequest FieldRequest? @relation(fields: [fieldRequestId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])

  @@index([userId])
  @@index([fieldRequestId])
  @@index([departmentId])
  @@index([actionByUserId])
}

// ====================================================================
// FLEET MODELS
// ====================================================================

model FieldRequest {
  id           String                @id @default(uuid()) @db.Uuid
  reqId        String                @db.Uuid
  departmentId String?               @db.Uuid
  fieldType    String
  description  String?
  location     String?
  fromDate     DateTime
  toDate       DateTime
  startTime    DateTime?
  endTime      DateTime?
  durationType String?
  isRead       ReadStatus            @default(CLOSED)
  status       RequestDecisionStatus @default(PENDING)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  requestor         User?               @relation(fields: [reqId], references: [id])
  department        Department?         @relation(fields: [departmentId], references: [id])
  FieldNotification FieldNotification[]
  HrNotification    HrNotification[]
  UserNotification  UserNotification[]

  @@index([reqId])
  @@index([departmentId])
}

model Vehicle {
  id              String    @id @default(uuid()) @db.Uuid
  plate           String    @unique
  make            String?
  model           String?
  year            Int?
  countryOfOrigin String?
  seatingCapacity Int?
  kmPerLiter      Float?
  vehicleTypeName String?
  chassisNumber   String?
  engineNumber    String?
  fuelType        String?
  cylinderCount   Int?
  userId          String?   @db.Uuid
  reqId           Int?
  isCompleted     Boolean   @default(false)
  endTime         DateTime?

  user                User?                 @relation(fields: [userId], references: [id])
  request             FleetRequest?         @relation(fields: [reqId], references: [id])
  trips               Trip[]
  createdAt           DateTime              @default(now())
  VehicleNotification VehicleNotification[]
  type                VehicleType           @default(NEW)

  DriverDetaile          DriverDetaile[]
  fleetCostRegistrations FleetCostRegistration[]
  maintenanceSchedules   MaintenanceSchedule[]
  maintainedVehicles     MaintainedVehicle[]
  VehicleReturn          VehicleReturn[]
  ServiceRegistration    ServiceRegistration[]
  fuelRequests           FuelRequest[]
  TripHistory            TripHistory[]
  maintenanceRequests    MaintenanceRequest[]
}

model FleetRequest {
  id           Int     @id @default(autoincrement())
  requestorId  String  @db.Uuid
  purpose      String
  tripType     String?
  destination  String?
  departmentId String? @db.Uuid

  durationType String?

  date      DateTime
  fromDate  DateTime?
  toDate    DateTime?
  startTime String?
  endTime   String?

  driverId String? @db.Uuid
  driver   User?   @relation("FleetRequestDriver", fields: [driverId], references: [id])

  startOdometerKm  Int?
  odometerKmDiff   Int?
  returnOdometerKm Int?
  returnTime       String?
  passengerCount   Int?

  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  requestor   User?         @relation("FleetRequestRequestor", fields: [requestorId], references: [id])
  department  Department?   @relation(fields: [departmentId], references: [id])
  vehicles    Vehicle[]
  User        User?         @relation(fields: [userId], references: [id])
  userId      String?       @db.Uuid
  TripHistory TripHistory[]
}

model Trip {
  id          String   @id @default(uuid()) @db.Uuid
  vehicleId   String   @db.Uuid
  driverId    String   @db.Uuid
  startAt     DateTime
  origin      String?
  destination String?
  distanceKm  Float?
  createdAt   DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  driver  User    @relation(fields: [driverId], references: [id])
}

model TripHistory {
  id String @id @default(uuid()) @db.Uuid

  fleetRequestId Int
  vehicleId      String  @db.Uuid
  driverId       String  @db.Uuid
  requestorId    String  @db.Uuid
  departmentId   String? @db.Uuid

  requesterName  String?
  requesterPhone String?
  purpose        String?
  destination    String?
  date           DateTime?
  startTime      String?
  endTime        String?

  startOdometerKm  Int?
  returnOdometerKm Int?
  odometerKmDiff   Int?
  passengerCount   Int?
  returnTime       String?
  status           String?

  vehiclePlate     String?
  vehicleMakeModel String?
  kmPerLiter       Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fleetRequest FleetRequest @relation(fields: [fleetRequestId], references: [id])
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  driver       User         @relation("TripHistoryDriver", fields: [driverId], references: [id])
  requestor    User         @relation("TripHistoryRequestor", fields: [requestorId], references: [id])

  @@index([fleetRequestId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([requestorId])
  @@index([departmentId])
}

model VehicleReturn {
  id String @id @default(uuid()) @db.Uuid

  driverId String @db.Uuid
  driver   User   @relation(fields: [driverId], references: [id])

  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  plateNumber String

  returnedAt      DateTime
  finalOdometerKm Int
  fuelLevel       String

  warningLightsOn   Boolean
  vehicleInspection String

  description String?

  fileUrl  String?
  fileName String?
  fileType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceRegistration {
  id String @id @default(uuid()) @db.Uuid

  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  plateNumber     String
  vehicleModel    String?
  odometerKm      Int
  reachedDate5000 DateTime?

  driverId   String? @db.Uuid
  driver     User?   @relation(fields: [driverId], references: [id])
  driverName String?

  garageName    String?
  serviceCenter String?
  serviceStart  DateTime?
  serviceEnd    DateTime?

  createdAt DateTime @default(now())
}

model MaintenanceSchedule {
  id                      String            @id @default(uuid()) @db.Uuid
  vehicleId               String            @db.Uuid
  userId                  String            @db.Uuid
  incidentDate            DateTime
  location                String?
  status                  MaintenanceStatus @default(PENDING)
  IncidentType            String?
  actionByUserId          String?           @db.Uuid
  description             String?
  maintenanceScheduleTime DateTime?
  remainingFuelKm         Float?
  fuelLevelStatus         String?
  severity                String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  vehicle  Vehicle @relation(fields: [vehicleId], references: [id])
  user     User    @relation("MaintenanceScheduleOwner", fields: [userId], references: [id])
  actionBy User?   @relation("MaintenanceScheduleActionBy", fields: [actionByUserId], references: [id])

  @@index([vehicleId])
  @@index([userId])
  @@index([actionByUserId])
}

model MaintainedVehicle {
  id            String   @id @default(uuid()) @db.Uuid
  vehicleId     String   @db.Uuid
  completedDate DateTime
  description   String?
  cost          Decimal? @db.Decimal(12, 2)

  imageUrl  String?
  createdAt DateTime                @default(now())
  status    MaintainedVehicleStatus

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
}

model FleetCostRegistration {
  id          String   @id @default(uuid()) @db.Uuid
  date        DateTime
  vehicleId   String   @db.Uuid
  category    String?
  amount      Decimal  @db.Decimal(14, 2)
  currency    String   @default("ETB")
  reference   String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
}

model FuelRequest {
  id          String @id @default(uuid()) @db.Uuid
  requestorId String @db.Uuid
  vehicleId   String @db.Uuid

  date                 DateTime
  odometer             Int
  amount               Float
  amountType           FuelAmountType
  notes                String?
  status               FuelStatus     @default(NOT_FUELED)
  returnOdometerKm     Int?
  remainingFuelRequest Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  user    User    @relation(fields: [requestorId], references: [id])
}

model DriverDetaile {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @db.Uuid
  empId                 String
  dateOfBirth           DateTime
  address               String?
  licenceNumber         String
  licenceClass          String
  licenceExpiredDate    DateTime
  issuedBy              String
  vehicleId             String?  @db.Uuid
  emergencyContactName  String
  emergencyContactPhone String
  additionalInformation String?
  licenceCertificate    String?
  image                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@unique([userId, empId])
  @@index([userId])
  @@index([vehicleId])
}

// ====================================================================
// FLEET MAINTENANCE REQUEST & APPROVAL WORKFLOW
// ====================================================================

model MaintenanceRequest {
  id           String   @id @default(uuid()) @db.Uuid
  requestNumber String  @unique
  driverId     String   @db.Uuid
  vehicleId    String   @db.Uuid
  priority     String?
  category     MaintenanceCategory
  problemDescription String
  vehicleCondition   VehicleCondition
  location     String?
  currentOdometerKm Int?
  employeeId   String?
  department   String?
  phone        String?
  attachments  String?
  status       MaintenanceRequestStatus @default(SUBMITTED)
  submittedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  driver       User       @relation("MaintenanceRequestDriver", fields: [driverId], references: [id])
  vehicle      Vehicle    @relation(fields: [vehicleId], references: [id])
  inspection   MaintenanceInspection?
  managerDecision FleetManagerDecision?
  task         MaintenanceTask?
  history      MaintenanceApprovalHistory[]

  @@index([driverId])
  @@index([vehicleId])
  @@index([status])
  @@index([requestNumber])
}

model MaintenanceInspection {
  id            String   @id @default(uuid()) @db.Uuid
  requestId     String   @unique @db.Uuid
  inspectionDate DateTime @default(now())
  inspectionOfficerId String @db.Uuid
  officerEmployeeId  String?
  problemVerified    Boolean
  technicalFindings  String?
  requiredRepairs    String?
  estimatedPartsCost Decimal? @db.Decimal(12, 2)
  estimatedLaborCost Decimal? @db.Decimal(12, 2)
  estimatedOtherCost Decimal? @db.Decimal(12, 2)
  estimatedDurationHours Float?
  workshop       WorkshopType?
  attachments    String?
  decision       InspectionDecision
  decisionReason String
  technicalJustification String?
  decidedAt      DateTime @default(now())
  signature      String?
  createdAt      DateTime @default(now())

  request  MaintenanceRequest @relation(fields: [requestId], references: [id])
  officer  User               @relation("MaintenanceInspectionOfficer", fields: [inspectionOfficerId], references: [id])

  @@index([requestId])
  @@index([inspectionOfficerId])
}

model FleetManagerDecision {
  id           String   @id @default(uuid()) @db.Uuid
  requestId    String   @unique @db.Uuid
  managerId    String   @db.Uuid
  decision     ManagerDecision
  remarks      String
  budgetAvailable Boolean?
  decidedAt    DateTime @default(now())
  signature    String?
  createdAt    DateTime @default(now())

  request MaintenanceRequest @relation(fields: [requestId], references: [id])
  manager User              @relation("FleetManagerDecisionManager", fields: [managerId], references: [id])

  @@index([requestId])
  @@index([managerId])
}

model MaintenanceTask {
  id            String   @id @default(uuid()) @db.Uuid
  requestId     String   @unique @db.Uuid
  technicianId  String?  @db.Uuid
  workshop      String?
  repairStartDate DateTime?
  partsUsed     String?
  actualCost    Decimal? @db.Decimal(12, 2)
  repairDescription String?
  completionDate DateTime?
  finalOdometerKm Int?
  vehicleStatus RepairVehicleStatus?
  technicianRemarks String?
  teamVerification Boolean @default(false)
  driverConfirmation Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  request    MaintenanceRequest @relation(fields: [requestId], references: [id])
  technician User?              @relation("MaintenanceTaskTechnician", fields: [technicianId], references: [id])

  @@index([requestId])
  @@index([technicianId])
}

model MaintenanceApprovalHistory {
  id          String   @id @default(uuid()) @db.Uuid
  requestId   String   @db.Uuid
  action      String
  fromStatus  MaintenanceRequestStatus?
  toStatus    MaintenanceRequestStatus?
  actorId     String?  @db.Uuid
  actorRole   String?
  notes       String?
  createdAt   DateTime @default(now())

  request MaintenanceRequest @relation(fields: [requestId], references: [id])
  actor   User?              @relation("MaintenanceHistoryActor", fields: [actorId], references: [id])

  @@index([requestId])
  @@index([actorId])
}
